{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nos-gemini-gateway",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "AUDIO_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["GEMINI_API_KEY", "ELEVENLABS_API_KEY"]
  },
  "vars": {
    "PUBLIC_APP_ORIGINS": "http://localhost:5173",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_MEDIA_MODEL": "gemini-3.5-flash-lite",
    "MAX_PROMPT_LENGTH": "40000",
    "MAX_REQUEST_BYTES": "1048576",
    "MAX_MEDIA_REQUEST_BYTES": "12582912",
    "MAX_MEDIA_FRAME_BYTES": "2097152",
    "MAX_MEDIA_FRAMES": "8",
    "MAX_AUDIO_REQUEST_BYTES": "26214400"
  }
}
