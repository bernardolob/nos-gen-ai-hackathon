{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nos-gemini-gateway",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-10",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "BackendContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "api": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "BackendContainer"
      }
    ]
  },
  "exports": {
    "BackendContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": ["GEMINI_API_KEY", "BACKEND_API_TOKEN"]
  },
  "vars": {
    "BACKEND_HOST": "0.0.0.0",
    "BACKEND_PORT": "8080",
    "BACKEND_WORKERS": "1",
    "BACKEND_PRODUCTION": "true",
    "BACKEND_CORS_ALLOW_ORIGINS": "",
    "BACKEND_MAX_PROMPT_LENGTH": "10000",
    "BACKEND_MAX_REQUEST_BYTES": "1048576"
  }
}
