# Create a new key in Google AI Studio and export it in your shell.
# Do not paste a real key into this file.
GEMINI_API_KEY=

# Optional operational settings
GEMINI_TIMEOUT_SECONDS=60
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1
GEMINI_RETRY_MAX_DELAY_SECONDS=8

# Backend access token. Generate a high-entropy value; never expose it to a
# browser application or commit a real value.
BACKEND_API_TOKEN=

# HTTP server and API policy
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_WORKERS=1
BACKEND_PRODUCTION=false
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:3000
BACKEND_MAX_BLOCK_COUNT=100
BACKEND_MAX_TEXT_LENGTH=10000
BACKEND_MAX_REQUEST_BYTES=1048576
