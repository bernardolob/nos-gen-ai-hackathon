# Export these in your shell. Do not paste real values into this file.

# Direct Gemini CLI (read only by src/gemini; not used by media review)
GEMINI_API_KEY=
# Media uses the Cloudflare gateway. The model must match wrangler.jsonc.
GEMINI_MEDIA_MODEL=gemini-3.5-flash-lite
GEMINI_GATEWAY_URL=https://nos-gemini-gateway.jnhorta05.workers.dev
GEMINI_GATEWAY_ORIGIN=http://localhost:5173
GEMINI_TIMEOUT_SECONDS=60
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1
GEMINI_RETRY_MAX_DELAY_SECONDS=8
# Optional official OpenCV YuNet ONNX model. Without it the offline Haar
# detector remains available as a compatibility fallback.
OPENCV_FACE_DETECTOR_MODEL=
# Optional local ResNet18 BiSeNet face parser in ONNX format. When omitted or
# invalid, face redaction deliberately falls back to the broader detector box.
OPENCV_FACE_PARSER_MODEL=

# Extra: censura de áudio, ElevenLabs Scribe (read by src/audio/elevenlabs_client.py)
ELEVENLABS_API_KEY=

# Context caching with the direct Gemini client (src/gemini_adapter.py)
GEMINI_CACHE_TTL_SECONDS=3600

# HTTP API (read by api/settings.py)
# Generate a separate high-entropy token for BACKEND_API_TOKEN.
BACKEND_API_TOKEN=
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_WORKERS=1
BACKEND_PRODUCTION=false
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:3000
BACKEND_MAX_PROMPT_LENGTH=10000
BACKEND_MAX_REQUEST_BYTES=1048576
